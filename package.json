{
  "name": "astro-scaffold",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-katex.mjs && node scripts/copy-admin.mjs && astro dev",
    "build": "node scripts/copy-katex.mjs && node scripts/copy-admin.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@sveltia/cms": "^0.215.0",
    "astro": "^7.3.3",
    "katex": "^0.18.7",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
