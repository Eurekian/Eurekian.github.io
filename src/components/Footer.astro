---
import { getEntry } from 'astro:content';

const today = new Date();
const profile = await getEntry('settings', 'profile');
---

<footer>
	<span>&copy; {today.getFullYear()} {profile.data.name}</span>
	<div class="links">
		<a href="/rss.xml">RSS</a>
		{
			profile.data.socials.map((s) => (
				<a href={s.url} target="_blank" rel="noopener noreferrer">
					{s.label}
				</a>
			))
		}
	</div>
</footer>
<style>
	footer {
		padding: 1.8em 1em;
		border-top: 1px solid var(--border);
		color: var(--text-soft);
		text-align: center;
		font-size: 0.9em;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 1.2em;
		margin-top: 0.5em;
	}
	.links a {
		color: var(--text-soft);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
