---
import { COLLECTIONS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header data-pagefind-ignore>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/works">全部</HeaderLink>
			{COLLECTIONS.map((c) => <HeaderLink href={`/${c.name}`}>{c.label}</HeaderLink>)}
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="aside-links">
			<button
				type="button"
				data-search-open
				aria-label="搜索（Ctrl 或 Cmd 加 K）"
				title="搜索（Ctrl/Cmd+K）"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.5-3.5"></path>
				</svg>
			</button>
			<button
				type="button"
				data-theme-toggle
				aria-label="切换深浅色主题"
				title="切换深浅色主题"
			>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
			<a href="https://github.com/Eurekian" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub 主页</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="26" height="26"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		white-space: nowrap;
	}
	h2 a {
		color: var(--text);
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5em;
	}
	nav a {
		padding: 0.9em 0.5em;
		color: var(--text);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
		white-space: nowrap;
	}
	nav a:hover {
		border-bottom-color: var(--border);
	}
	nav a.active {
		border-bottom-color: var(--accent);
		font-weight: 600;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.aside-links {
		display: flex;
		align-items: center;
		gap: 0.4em;
	}
	.aside-links a {
		display: flex;
		padding: 0.6em 0.4em;
		color: var(--text-soft);
	}
	.aside-links a:hover {
		color: var(--text);
	}
	[data-theme-toggle],
	[data-search-open] {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.2em;
		height: 2.2em;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--text-soft);
	}
	[data-theme-toggle]:hover,
	[data-search-open]:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	.icon-sun {
		display: none;
	}
	.icon-moon {
		display: block;
	}
	:global([data-theme='dark']) .icon-sun {
		display: block;
	}
	:global([data-theme='dark']) .icon-moon {
		display: none;
	}
	@media (max-width: 720px) {
		.internal-links {
			overflow-x: auto;
			flex-wrap: nowrap;
		}
		nav a {
			padding: 0.8em 0.45em;
		}
	}
</style>
