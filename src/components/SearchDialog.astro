---
// 站内搜索弹窗：全部/标题/正文三档模式（逻辑见 /search.js）。
// 结果为独立卡片（仅徽标+标题）；悬停/聚焦时行右侧浮出内容预览（#search-popover，
// 由脚本挂到 body 并以 fixed 定位，避免被弹窗滚动容器裁剪）。
// 唤起方式：Header 的搜索按钮（data-search-open）或 Ctrl/Cmd+K。
---

<div id="search-backdrop" hidden></div>
<div id="search-dialog" hidden role="dialog" aria-modal="true" aria-label="站内搜索">
	<input id="search-input" type="search" placeholder="搜索作品、公式、代码…" autocomplete="off" />
	<div id="search-modes" role="group" aria-label="搜索范围">
		<button type="button" class="mode active" data-mode="all">全部</button>
		<button type="button" class="mode" data-mode="title">标题</button>
		<button type="button" class="mode" data-mode="body">正文</button>
	</div>
	<div id="search-status" class="status"></div>
	<div id="search-results"></div>
</div>
<div id="search-popover" class="popover" hidden></div>

<script is:inline src="/search.js" defer></script>

<style>
	#search-backdrop {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: rgba(0, 0, 0, 45%);
	}
	#search-dialog {
		position: fixed;
		top: 12vh;
		left: 50%;
		transform: translateX(-50%);
		z-index: 51;
		width: min(40em, calc(100vw - 2em));
		max-height: 65vh;
		overflow-y: auto;
		padding: 0.8em;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg);
		box-shadow: var(--box-shadow);
	}
	#search-input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.6em 0.9em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-soft);
		color: var(--text);
	}
	#search-input:focus {
		outline: 2px solid var(--accent);
	}
	#search-modes {
		display: flex;
		gap: 0.4em;
		margin: 0.55em 0 0.1em;
	}
	#search-modes .mode {
		padding: 0.1em 0.85em;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg);
		color: var(--text-soft);
		font-size: 0.82em;
	}
	#search-modes .mode:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	#search-modes .mode.active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.status {
		margin: 0.4em 0.2em 0.2em;
		font-size: 0.8em;
		color: var(--text-soft);
	}
	#search-results {
		display: grid;
		gap: 0.55em;
		margin-top: 0.3em;
	}
	.hit {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.55em 0.75em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.12s ease;
	}
	.hit:hover,
	.hit:focus-visible {
		border-color: var(--accent);
		background: var(--bg-soft);
	}
	.badge {
		flex: none;
		padding: 0.05em 0.55em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.74em;
		color: var(--text-soft);
		white-space: nowrap;
	}
	.hit-title {
		font-weight: 600;
		line-height: 1.5;
	}
	.hit :global(mark) {
		background: var(--accent-weak);
		color: var(--accent);
		font-weight: 700;
	}
	.empty {
		padding: 1em 0.2em;
		color: var(--text-soft);
		text-align: center;
	}

	/* 悬停预览浮层（fixed，挂在 body 下；样式经 data 属性作用域仍然生效） */
	.popover {
		position: fixed;
		z-index: 60;
		max-width: 320px;
		max-height: 40vh;
		overflow-y: auto;
		padding: 0.7em 0.9em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		box-shadow: var(--box-shadow);
		font-size: 0.88em;
		pointer-events: none;
	}
	.pop-cat {
		display: inline-block;
		margin-bottom: 0.3em;
		padding: 0.02em 0.55em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.82em;
		color: var(--text-soft);
	}
	.pop-title {
		font-weight: 700;
		margin-bottom: 0.35em;
		line-height: 1.45;
	}
	.pop-text {
		color: var(--text-soft);
		line-height: 1.6;
	}
</style>
