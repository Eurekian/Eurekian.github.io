---
// 站内搜索弹窗：首次打开时才懒加载 /pagefind/pagefind.js（构建产物内的本地索引）。
// 唤起方式：Header 的搜索按钮（data-search-open）或 Ctrl/Cmd+K。
---

<div id="search-backdrop" hidden></div>
<div id="search-dialog" hidden role="dialog" aria-modal="true" aria-label="站内搜索">
	<input id="search-input" type="search" placeholder="搜索作品、公式、代码…" autocomplete="off" />
	<div id="search-status" class="status"></div>
	<div id="search-results"></div>
</div>

<script>
	// 类型收窄：pagefind 由运行时动态加载
	type Pagefind = {
		search: (q: string) => Promise<{
			results: Array<{ data: () => Promise<{ url: string; meta: { title?: string }; excerpt?: string }> }>;
		}>;
	};

	let pagefind: Pagefind | null = null;
	let loading = false;
	let debounceTimer: ReturnType<typeof setTimeout> | undefined;

	const backdrop = document.getElementById('search-backdrop')!;
	const dialog = document.getElementById('search-dialog')!;
	const input = document.getElementById('search-input') as HTMLInputElement;
	const statusEl = document.getElementById('search-status')!;
	const resultsEl = document.getElementById('search-results')!;

	function open() {
		backdrop.hidden = false;
		dialog.hidden = false;
		input.focus();
	}

	function close() {
		backdrop.hidden = true;
		dialog.hidden = true;
	}

	async function ensurePagefind(): Promise<Pagefind | null> {
		if (pagefind) return pagefind;
		if (loading) return null;
		loading = true;
		try {
			// 用 new Function 隐藏动态导入，避免打包器把它改写成带
			// __VITE_PRELOAD__ 的辅助调用（内联脚本中未定义，必然抛错）
			pagefind = (await new Function("return import('/pagefind/pagefind.js')")()) as Pagefind;
		} catch {
			statusEl.textContent = '搜索索引加载失败，请刷新重试';
			return null;
		} finally {
			loading = false;
		}
		return pagefind;
	}

	function escapeHtml(s: string) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	async function runSearch() {
		const q = input.value.trim();
		const pf = await ensurePagefind();
		if (!pf) return;
		if (q.length < 2) {
			statusEl.textContent = '';
			resultsEl.innerHTML = '';
			return;
		}
		statusEl.textContent = '搜索中…';
		const res = await pf.search(q);
		statusEl.textContent = `共 ${res.results.length} 条结果`;
		const items = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
		resultsEl.innerHTML = items
			.map(
				(i) =>
					`<a class="hit" href="${i.url}"><span class="hit-title">${escapeHtml(i.meta?.title ?? '(无标题)')}</span><span class="hit-excerpt">${i.excerpt ?? ''}</span></a>`
			)
			.join('');
		if (items.length === 0) resultsEl.innerHTML = '<div class="empty">没有匹配的内容。</div>';
	}

	document.addEventListener('click', (e) => {
		const target = e.target instanceof Element ? e.target : null;
		if (target?.closest('[data-search-open]')) {
			e.preventDefault();
			open();
		}
	});

	backdrop.addEventListener('click', close);
	document.addEventListener('keydown', (e) => {
		if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
			e.preventDefault();
			dialog.hidden ? open() : close();
		}
		if (e.key === 'Escape' && !dialog.hidden) close();
	});

	input.addEventListener('input', () => {
		clearTimeout(debounceTimer);
		debounceTimer = setTimeout(runSearch, 180);
	});
</script>

<style>
	#search-backdrop {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: rgba(0, 0, 0, 45%);
	}
	#search-dialog {
		position: fixed;
		top: 12vh;
		left: 50%;
		transform: translateX(-50%);
		z-index: 51;
		width: min(40em, calc(100vw - 2em));
		max-height: 65vh;
		overflow-y: auto;
		padding: 0.8em;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg);
		box-shadow: var(--box-shadow);
	}
	#search-input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.6em 0.9em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-soft);
		color: var(--text);
	}
	#search-input:focus {
		outline: 2px solid var(--accent);
	}
	.status {
		margin: 0.5em 0.2em 0.3em;
		font-size: 0.82em;
		color: var(--text-soft);
	}
	.hit {
		display: block;
		padding: 0.55em 0.7em;
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
	}
	.hit:hover {
		background: var(--bg-soft);
	}
	.hit-title {
		display: block;
		font-weight: 600;
	}
	.hit-excerpt {
		display: block;
		margin-top: 0.15em;
		font-size: 0.84em;
		color: var(--text-soft);
	}
	.hit-excerpt :global(mark) {
		background: var(--accent-weak);
		color: var(--accent);
	}
	.empty {
		padding: 1em 0.2em;
		color: var(--text-soft);
		text-align: center;
	}
</style>
