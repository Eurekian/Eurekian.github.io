---
// 站内搜索弹窗：首次打开时才懒加载 /pagefind/pagefind.js（构建产物内的本地索引）。
// 唤起方式：Header 的搜索按钮（data-search-open）或 Ctrl/Cmd+K。
---

<div id="search-backdrop" hidden></div>
<div id="search-dialog" hidden role="dialog" aria-modal="true" aria-label="站内搜索">
	<input id="search-input" type="search" placeholder="搜索作品、公式、代码…" autocomplete="off" />
	<div id="search-status" class="status"></div>
	<div id="search-results"></div>
</div>

<script is:inline src="/search.js" defer></script>

<style>
	#search-backdrop {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: rgba(0, 0, 0, 45%);
	}
	#search-dialog {
		position: fixed;
		top: 12vh;
		left: 50%;
		transform: translateX(-50%);
		z-index: 51;
		width: min(40em, calc(100vw - 2em));
		max-height: 65vh;
		overflow-y: auto;
		padding: 0.8em;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg);
		box-shadow: var(--box-shadow);
	}
	#search-input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.6em 0.9em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-soft);
		color: var(--text);
	}
	#search-input:focus {
		outline: 2px solid var(--accent);
	}
	.status {
		margin: 0.5em 0.2em 0.3em;
		font-size: 0.82em;
		color: var(--text-soft);
	}
	.hit {
		display: block;
		padding: 0.55em 0.7em;
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
	}
	.hit:hover {
		background: var(--bg-soft);
	}
	.hit-title {
		display: block;
		font-weight: 600;
	}
	.hit-excerpt {
		display: block;
		margin-top: 0.15em;
		font-size: 0.84em;
		color: var(--text-soft);
	}
	.hit-excerpt :global(mark) {
		background: var(--accent-weak);
		color: var(--accent);
	}
	.empty {
		padding: 1em 0.2em;
		color: var(--text-soft);
		text-align: center;
	}
</style>
