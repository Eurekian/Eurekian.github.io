---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
	title: string;
	description: string;
	/** 宽版布局（首页等）；作品详情用 Work.astro 自行控制 */
	wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<script is:inline src="/theme.js"></script>
		<BaseHead title={title} description={description} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main class={wide ? 'wide' : ''} data-pagefind-body>
			<slot />
		</main>
		<Footer />
		<SearchDialog />
	</body>
</html>

<style>
	main {
		width: 46em;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 2.5em 1em;
		min-height: 60vh;
	}
	main.wide {
		width: 60em;
	}
</style>
