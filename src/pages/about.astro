---
import Layout from '../layouts/BlogPost.astro';
import { getEntry } from 'astro:content';

const profile = await getEntry('settings', 'profile');
const d = profile.data;
---

<Layout title={`关于 · ${d.name}`} description={d.tagline} pubDate={new Date('2026-09-18')}>
	<h2>{d.name}</h2>
	<p>{d.bio}</p>
	{d.research.length > 0 && <p>方向：{d.research.join(' / ')}</p>}
	<ul>
		{
			d.socials.map((s) => (
				<li>
					<a href={s.url} target="_blank" rel="noopener noreferrer">
						{s.label}
					</a>
				</li>
			))
		}
	</ul>
	<p class="note">（个人信息为占位内容，搭建完成后可在管理后台随时修改）</p>
</Layout>

<style>
	.note {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
