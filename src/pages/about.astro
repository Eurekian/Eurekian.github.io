---
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';
import { getEntry } from 'astro:content';

const d = (await getEntry('settings', 'profile')).data;
---

<Base title={`关于 · ${SITE_TITLE}`} description={d.tagline}>
	<h1>关于</h1>
	<div class="card">
		<h2>{d.name}</h2>
		<p class="tagline">{d.tagline}</p>
		<p>{d.bio}</p>
		{
			d.research.length > 0 && (
				<div class="chips" aria-label="方向">
					{d.research.map((r) => (
						<span>{r}</span>
					))}
				</div>
			)
		}
		{
			(d.email || d.socials.length > 0) && (
				<div class="contact">
					{d.email && (
						<a href={`mailto:${d.email}`}>{d.email}</a>
					)}
					{d.socials.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer">
							{s.label}
						</a>
					))}
				</div>
			)
		}
	</div>
	<div class="card credits">
		<h2>图片来源与致谢</h2>
		<p>
			本站左右两侧的装饰插画使用的是东方 Project 相关二次创作作品：
		</p>
		<ul>
			<li>夜间模式：帕秋莉·诺蕾姬与书堆，画师 <code>@Kosu</code>（2026.8）。</li>
			<li>白天模式：古明地恋与书堆，画师信息整理中，确认后补全。</li>
		</ul>
		<p>
			东方 Project 原作及角色版权归上海爱丽丝幻乐团（ZUN）所有，本站为非商业个人用途，仅在页面边缘做装饰性展示。若您是权利人并希望本站调整或撤下相关图片，请通过上方联系方式告知。
		</p>
	</div>
	<p class="note">个人信息可在管理后台随时修改，修改后站点自动更新。</p>
</Base>

<style>
	h1 {
		font-size: 1.8em;
		margin-bottom: 0.8em;
	}
	.card {
		padding: 1.6em 1.8em;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.card h2 {
		margin-bottom: 0.1em;
	}
	.tagline {
		color: var(--accent);
		margin-bottom: 1em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0.8em 0;
	}
	.chips span {
		padding: 0.1em 0.8em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.85em;
		color: var(--text-soft);
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2em;
		margin-top: 1em;
		font-size: 0.95em;
	}
	.note {
		margin-top: 1.5em;
		color: var(--text-soft);
		font-size: 0.85em;
	}
	.credits {
		margin-top: 1.5em;
		font-size: 0.9em;
	}
	.credits h2 {
		font-size: 1.1em;
		margin-bottom: 0.5em;
	}
	.credits ul {
		margin: 0.5em 0;
		padding-left: 1.4em;
	}
	.credits p {
		margin: 0.4em 0;
		color: var(--text-soft);
	}
</style>
