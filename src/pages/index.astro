---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getEntry } from 'astro:content';

const profile = await getEntry('settings', 'profile');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="hero">
			<h1>{profile.data.name}</h1>
			<p class="tagline">{profile.data.tagline}</p>
			<p>{profile.data.bio}</p>
			<p class="status">站点搭建中：分类页面与作品内容将在后续阶段陆续上线。</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin: auto;
		padding: 2em 1em;
		max-width: 46em;
	}
	.hero {
		text-align: center;
	}
	h1 {
		margin-bottom: 0.2em;
	}
	.tagline {
		color: rgb(var(--gray));
		font-size: 1.1em;
		margin-bottom: 1.5em;
	}
	.status {
		margin-top: 2em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
